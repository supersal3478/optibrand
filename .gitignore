.env
.env.*
!.env.example

__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.venv/
venv/
dist/
build/

# Hermes runtime — never commit
.hermes/

# Local state we never commit
data/
logs/

# Your real schedule and draft content — never commit (private + frequently edited)
schedule.yaml
drafts/*
!drafts/.gitkeep

# Normalized corpus is regenerated by scripts/ingest-corpus.py
corpus/_normalized.jsonl

# Symlink into ~/.hermes/memories/voice_profile.json — convenience only, not source of truth
voice_profile.json

*.session
*.har
*.db
*.db-journal
*.db-wal
*.db-shm

# OS
.DS_Store

# Corpus is private to the user — uncomment to gitignore
# corpus/*.jsonl

# Approval proof — never commit
corpus/x_approval.pdf

# Live API key reference — never commit
51_AZURE_LLM_DEPLOYMENTS_AND_AGENT_RULES.md
*_LLM_DEPLOYMENTS_*.md

# Risk acknowledgment — uncomment if you don't want to commit your signature
# RISK_ACCEPTED.md

# Vendored upstream Hermes (cloned from NousResearch/hermes-agent).
# Not committed — too large (~230MB) and the upstream is public. The vendor/README.md
# in this repo documents how to restore the directory on a fresh clone.
vendor/*
!vendor/README.md
